---
const pathname = Astro.url.pathname;

const navItems = [
  { label: "Home", href: "/", active: pathname === "/" },
  { label: "Build", href: "/build", active: pathname.startsWith("/build") }
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-brand" aria-label="SFF Builder homepage">
      <span class="site-brand__mark" aria-hidden="true">SFF</span>
      <span class="site-brand__name">SFF Builder</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      {navItems.map((item) => (
        <a class:list={["site-nav__item", { "site-nav__item--active": item.active }]} href={item.href} aria-current={item.active ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="site-header__tools">
      <a href="/build" class="site-header__cta">Open build</a>
      <button type="button" data-theme-toggle class="site-theme-toggle" aria-label="Toggle theme">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M12 3v2.5M12 18.5V21M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M3 12h2.5M18.5 12H21M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path>
          <circle cx="12" cy="12" r="4.4"></circle>
        </svg>
      </button>
    </div>
  </div>
</header>
