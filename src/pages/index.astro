---
import BaseLayout from "../layouts/BaseLayout.astro";

const quickSearchTerms = [
  { label: "FormD T1", kind: "case" },
  { label: "RTX 4090", kind: "gpu" },
  { label: "Velka 3", kind: "case" },
  { label: "NH-L9i", kind: "cpu-cooler" },
  { label: "SF750", kind: "psu" }
];

const launchPaths = [
  {
    kind: "case",
    eyebrow: "Case-first flow",
    title: "Start with a Case",
    copy: "Browse cases by volume, GPU envelope, riser notes, and layout constraints before you commit to a build path.",
    cta: "Browse database",
    samples: ["FormD T1 · 9.95L", "Velka 3 · 3.96L", "A4-H2O · 11.0L"]
  },
  {
    kind: "gpu",
    eyebrow: "GPU-first flow",
    title: "Start with a GPU",
    copy: "Start from the card you own, then move into `/build` with its dimensions and fitment evidence in view.",
    cta: "Find fitment",
    samples: ["RTX 4090 · 304mm", "RX 7900 XTX · 287mm", "ProArt 4080 · 300mm"]
  }
];

const referenceChecks = [
  ["Fractal Terra + 4080 FE", "Reference check: 3.4mm CPU clearance margin noted"],
  ["FormD T1 + ProArt 4080", "Reference check: radiator and tube routing caveat retained"],
  ["Velka 3 + ITX 4060", "Reference check: Flex-ATX PSU constraint stays visible"],
  ["A4-H2O + Strix 4070 Ti", "Reference check: triple-slot width requires close review"]
];

const principles = [
  {
    title: "Millimeter-first fitment",
    copy: "The launcher points into a table-driven engine built around physical envelopes, not generic parts browsing."
  },
  {
    title: "Pass, conditional, fail",
    copy: "Known conflicts stay visible next to uncertain rows so builders can inspect risk instead of having it filtered away."
  },
  {
    title: "Replayable URL state",
    copy: "Selections and filters move into `/build` as readable query parameters that can be shared, reopened, and debugged."
  }
];

const footerLinks = [
  { label: "Open build workspace", href: "/build" },
  { label: "Launcher section", href: "#launcher" },
  { label: "Reference checks", href: "#proof" }
];
---

<BaseLayout
  title="SFF Builder | Precision PC Planning"
  description="Launcher homepage for the SFF Builder fitment engine. Search parts, start from a case or GPU, and hand off into /build with replayable URL state."
>
  <div class="min-h-screen">
    <header class="sticky top-0 z-50 border-b border-line/80 bg-canvas/94 backdrop-blur-sm">
      <div class="mx-auto flex max-w-[80rem] items-center justify-between gap-6 px-shell py-4">
        <div class="flex items-center gap-8">
          <a href="#top" class="font-sans text-[1.45rem] font-extrabold tracking-[-0.04em] text-accent-strong">SFF Builder</a>
          <nav class="hidden items-center gap-8 text-[0.95rem] text-ink-soft md:flex">
            <a class="border-b-2 border-accent pb-1 font-semibold text-ink" href="#launcher">Builder</a>
            <a class="transition hover:text-ink" href="#proof">Proof</a>
            <a class="transition hover:text-ink" href="/build">Workspace</a>
          </nav>
        </div>

        <div class="flex items-center gap-3">
          <a
            href="/build"
            class="hidden border border-line bg-panel-2 px-4 py-2 text-sm font-semibold text-ink transition hover:border-line-strong hover:bg-panel md:inline-flex"
          >
            Open /build
          </a>
          <button
            type="button"
            data-theme-toggle
            class="inline-flex h-10 w-10 items-center justify-center border border-line bg-panel text-ink-soft transition hover:border-line-strong hover:text-ink"
            aria-label="Toggle theme"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7">
              <path d="M12 3v2.5M12 18.5V21M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M3 12h2.5M18.5 12H21M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path>
              <circle cx="12" cy="12" r="4.4"></circle>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="top">
      <section class="surface-grid border-b border-line/70 px-shell pb-10 pt-14 md:pb-14">
        <div class="mx-auto max-w-[80rem]">
          <div class="inline-flex items-center gap-2 border border-line bg-panel-2/80 px-3 py-1.5 font-mono text-[0.72rem] uppercase tracking-[0.16em] text-ink-soft">
            <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
            Route status: `/build` live // URL state public
          </div>
        </div>
      </section>

      <section id="launcher" class="bg-canvas-2/38 px-shell py-8 md:py-12">
        <div class="mx-auto flex max-w-[80rem] flex-col gap-4">
          <section class="launcher-panel p-6 md:p-8">
            <div class="flex items-center gap-3">
              <svg viewBox="0 0 24 24" class="h-5 w-5 text-accent" fill="none" stroke="currentColor" stroke-width="1.75">
                <circle cx="11" cy="11" r="6.5"></circle>
                <path d="M16 16L21 21"></path>
              </svg>
              <h1 class="micro-label text-ink">Quick search</h1>
            </div>

            <form class="mt-6" data-autocomplete-root>
              <label class="relative block">
                <span class="sr-only">Search components</span>
                <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-ink-faint" fill="none" stroke="currentColor" stroke-width="1.75">
                  <circle cx="11" cy="11" r="6.5"></circle>
                  <path d="M16 16L21 21"></path>
                </svg>
                <input
                  data-autocomplete-input
                  type="text"
                  placeholder="Search case, GPU, or CPU cooler..."
                  class="h-14 w-full border border-line bg-canvas-2/85 pl-12 pr-4 text-base text-ink outline-none transition placeholder:text-ink-faint focus:border-accent"
                  autocomplete="off"
                />
              </label>
              <div data-autocomplete-panel class="relative z-[70] mt-2 hidden border border-line bg-panel shadow-card">
                <div data-autocomplete-status class="px-4 py-3 text-sm text-ink-soft"></div>
                <div data-autocomplete-results class="grid"></div>
              </div>
            </form>

            <div class="mt-5 flex flex-wrap gap-2">
              {quickSearchTerms.map((term) => (
                <button
                  type="button"
                  class="spec-chip"
                  data-suggested-part
                  data-launch-query={term.label}
                  data-launch-kind={term.kind}
                >
                  {term.label}
                </button>
              ))}
            </div>

            <div class="mt-8 border-t border-line/80 pt-5 text-[1.05rem] text-ink-soft">
              Search the catalog, then launch into `/build` with a readable handoff instead of hidden session state.
            </div>
          </section>

          <div class="flex items-center gap-3 px-2">
            <svg viewBox="0 0 24 24" class="h-5 w-5 text-accent" fill="none" stroke="currentColor" stroke-width="1.75">
              <path d="M12 3v5"></path>
              <path d="M8 21l4-5 4 5"></path>
              <path d="M8.5 8.5h7v6h-7z"></path>
            </svg>
            <p class="micro-label text-ink">Build wizard</p>
          </div>

          <div class="grid gap-4 lg:grid-cols-2">
            {launchPaths.map((path) => (
              <section class="launcher-panel flex min-h-[19rem] flex-col justify-between p-6 md:p-7">
                <div>
                  <div class="mb-6 flex h-11 w-11 items-center justify-center bg-panel-3 text-accent">
                    {
                      path.kind === "case" ? (
                        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.75">
                          <path d="M6 5.5h12v13H6z"></path>
                          <path d="M9 9h6"></path>
                          <path d="M9 12.5h6"></path>
                        </svg>
                      ) : (
                        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.75">
                          <rect x="5.5" y="6.5" width="13" height="11"></rect>
                          <path d="M9 10h2M13 10h2M9 13h2M13 13h2"></path>
                        </svg>
                      )
                    }
                  </div>

                  <p class="micro-label mb-2">{path.eyebrow}</p>
                  <h2 class="text-[clamp(1.7rem,2.8vw,2.1rem)] font-semibold tracking-[-0.03em] text-ink">{path.title}</h2>
                  <p class="mt-3 max-w-[34rem] text-[1.02rem] leading-7 text-ink-soft">{path.copy}</p>

                  <form class="relative mt-6 block" data-autocomplete-root data-kind={path.kind} data-launch-kind={path.kind}>
                    <span class="sr-only">{path.title}</span>
                    <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-faint" fill="none" stroke="currentColor" stroke-width="1.75">
                      <circle cx="11" cy="11" r="6.5"></circle>
                      <path d="M16 16L21 21"></path>
                    </svg>
                    <input
                      data-autocomplete-input
                      type="text"
                      placeholder={path.kind === "case" ? "Search cases..." : "Search GPUs..."}
                      class="h-11 w-full border border-line bg-canvas-2/85 pl-10 pr-4 text-sm text-ink outline-none transition placeholder:text-ink-faint focus:border-accent"
                      autocomplete="off"
                    />
                    <div data-autocomplete-panel class="absolute left-0 right-0 top-[calc(100%+0.5rem)] z-[70] hidden border border-line bg-panel shadow-card">
                      <div data-autocomplete-status class="px-4 py-3 text-sm text-ink-soft"></div>
                      <div data-autocomplete-results class="grid"></div>
                    </div>
                  </form>

                  <div class="mt-4 flex flex-wrap gap-2">
                    {path.samples.map((sample) => (
                      <button
                        type="button"
                        class="spec-chip"
                        data-suggested-part
                        data-launch-query={sample.split(" · ")[0]}
                        data-launch-kind={path.kind}
                      >
                        {sample}
                      </button>
                    ))}
                  </div>
                </div>

                <a
                  href={path.kind === "case" ? "/build?kind=case" : "/build?kind=gpu"}
                  class="mt-8 inline-flex items-center justify-between gap-4 font-mono text-[0.72rem] font-semibold uppercase tracking-[0.12em] text-accent transition hover:text-accent-strong"
                >
                  <span>{path.cta}</span>
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.75">
                    <path d="M5 12h14"></path>
                    <path d="M13 6l6 6-6 6"></path>
                  </svg>
                </a>
              </section>
            ))}
          </div>
        </div>
      </section>

      <section id="proof" class="border-y border-line/80 bg-panel/68 px-shell py-14">
        <div class="mx-auto grid max-w-[80rem] gap-10 lg:grid-cols-[minmax(0,1.65fr)_20.5rem]">
          <div>
            <div class="mb-8 flex items-center justify-between gap-4">
              <div class="flex items-center gap-3">
                <svg viewBox="0 0 24 24" class="h-5 w-5 text-accent" fill="none" stroke="currentColor" stroke-width="1.75">
                  <path d="M12 3l7 3v6c0 4.3-2.6 7.6-7 9-4.4-1.4-7-4.7-7-9V6l7-3z"></path>
                  <path d="M9 12l2 2 4-4"></path>
                </svg>
                <p class="micro-label text-ink">Reference checks</p>
              </div>
              <a href="/build" class="text-sm text-accent transition hover:text-accent-strong">Open fitment workspace</a>
            </div>

            <div class="grid gap-4 md:grid-cols-2">
              {referenceChecks.map(([title, copy]) => (
                <article class="proof-row">
                  <div class="proof-row__icon">
                    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.75">
                      <path d="M7 12.5l3 3 7-7"></path>
                    </svg>
                  </div>
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="proof-row__label">check</span>
                      <h3 class="font-mono text-sm font-semibold text-ink md:text-[0.97rem]">{title}</h3>
                    </div>
                    <p class="mt-1.5 text-sm text-ink-soft">{copy}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>

          <aside class="launcher-panel p-8">
            <h2 class="text-[2rem] font-semibold tracking-[-0.04em] text-ink">Why SFF Builder?</h2>
            <ul class="mt-8 grid gap-7">
              {principles.map((item) => (
                <li class="grid gap-2 border-b border-line/70 pb-6 last:border-b-0 last:pb-0">
                  <p class="text-[1.05rem] font-semibold text-ink">{item.title}</p>
                  <p class="text-sm leading-7 text-ink-soft">{item.copy}</p>
                </li>
              ))}
            </ul>
          </aside>
        </div>
      </section>
    </main>

    <footer class="bg-canvas px-shell py-12">
      <div class="mx-auto grid max-w-[80rem] gap-10 border-t border-line/80 pt-10 md:grid-cols-[minmax(0,1fr)_auto]">
        <div class="max-w-sm">
          <p class="micro-label mb-4 text-accent-strong">SFF Builder</p>
          <p class="text-[1.8rem] font-medium tracking-[-0.04em] text-ink">
            A launcher into the fitment engine, tuned for builders who would rather inspect evidence than guess.
          </p>
        </div>

        <div class="grid gap-x-12 gap-y-6 text-sm md:grid-cols-2">
          <div class="grid gap-3">
            <p class="micro-label text-ink">Platform</p>
            {footerLinks.map((link) => (
              <a href={link.href} class="text-ink-soft transition hover:text-ink">{link.label}</a>
            ))}
          </div>
          <div class="grid gap-3">
            <p class="micro-label text-ink">Fitment rules</p>
            <span class="text-ink-soft">`pass` stays visible</span>
            <span class="text-ink-soft">`conditional` keeps uncertainty</span>
            <span class="text-ink-soft">`fail` marks known hard conflicts</span>
          </div>
        </div>
      </div>
    </footer>
  </div>

  <script is:inline>
    const root = document.documentElement;
    const toggle = document.querySelector("[data-theme-toggle]");

    const applyTheme = (theme) => {
      root.dataset.theme = theme;
      localStorage.setItem("theme", theme);
      toggle?.setAttribute("aria-pressed", String(theme === "light"));
    };

    if (!localStorage.getItem("theme")) {
      const prefersLight = window.matchMedia("(prefers-color-scheme: light)").matches;
      root.dataset.theme = prefersLight ? "light" : "dark";
    }

    toggle?.addEventListener("click", () => {
      const nextTheme = root.dataset.theme === "light" ? "dark" : "light";
      applyTheme(nextTheme);
    });

    const toBuildUrl = ({ query = "", selectedKind = "", selectedId = "", launchKind = "" }) => {
      const params = new URLSearchParams();
      const normalizedLaunchKind = launchKind || selectedKind;
      const selectableKinds = new Set(["case", "gpu", "psu", "cpu-cooler", "motherboard", "ram"]);

      if (selectedId && selectableKinds.has(selectedKind)) {
        params.set(selectedKind, selectedId);
        if (selectedKind === "case") {
          params.set("kind", "gpu");
        } else if (selectedKind === "gpu") {
          params.set("kind", "case");
        } else {
          params.set("kind", selectedKind);
        }
      } else {
        if (normalizedLaunchKind) params.set("kind", normalizedLaunchKind);
        if (query.trim()) params.set("search", query.trim());
      }

      const suffix = params.toString();
      return suffix ? `/build?${suffix}` : "/build";
    };

    const autocompleteRoots = document.querySelectorAll("[data-autocomplete-root]");

    const resolveSuggestedPart = async ({ query, launchKind }) => {
      const params = new URLSearchParams({ q: query, limit: "1" });
      if (launchKind) params.set("kind", launchKind);

      const response = await fetch(`/api/catalog/search?${params.toString()}`);
      if (!response.ok) {
        throw new Error(`${response.status} ${response.statusText}`);
      }

      const payload = await response.json();
      return payload.suggestions?.[0] ?? null;
    };

    document.querySelectorAll("[data-suggested-part]").forEach((button) => {
      button.addEventListener("click", async () => {
        const query = button.dataset.launchQuery ?? "";
        const launchKind = button.dataset.launchKind ?? "";

        try {
          const suggestion = await resolveSuggestedPart({ query, launchKind });
          if (suggestion) {
            window.location.href = toBuildUrl({
              selectedKind: suggestion.kind,
              selectedId: suggestion.id,
              query: suggestion.displayName,
              launchKind
            });
            return;
          }
        } catch (error) {
          // Fall back to query-state handoff if the lookup path is unavailable.
        }

        window.location.href = toBuildUrl({ query, launchKind });
      });
    });

    autocompleteRoots.forEach((autocompleteRoot) => {
      const input = autocompleteRoot.querySelector("[data-autocomplete-input]");
      const panel = autocompleteRoot.querySelector("[data-autocomplete-panel]");
      const status = autocompleteRoot.querySelector("[data-autocomplete-status]");
      const results = autocompleteRoot.querySelector("[data-autocomplete-results]");
      const kind = autocompleteRoot.dataset.kind;
      const launchKind = autocompleteRoot.dataset.launchKind ?? kind ?? "";

      if (!input || !panel || !status || !results) return;

      let debounceTimer;
      let activeRequest = 0;
      let activeSuggestions = [];

      const closePanel = () => {
        panel.classList.add("hidden");
      };

      const openPanel = () => {
        panel.classList.remove("hidden");
      };

      const navigateToSuggestion = (suggestion) => {
        input.value = suggestion.displayName;
        window.location.href = toBuildUrl({
          selectedKind: suggestion.kind,
          selectedId: suggestion.id,
          query: suggestion.displayName,
          launchKind
        });
      };

      const renderState = (message) => {
        status.textContent = message;
        results.replaceChildren();
      };

      const renderSuggestions = (suggestions) => {
        results.replaceChildren();

        suggestions.forEach((suggestion) => {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "autocomplete-result";
          button.innerHTML = `
            <strong class="text-sm font-semibold text-ink">${suggestion.displayName}</strong>
            <span class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-ink-faint">${suggestion.kind} / ${suggestion.sourceSheet} #${suggestion.rowNumber}</span>
          `;
          button.addEventListener("pointerdown", (event) => {
            event.preventDefault();
            navigateToSuggestion(suggestion);
          });
          results.append(button);
        });
      };

      const fetchSuggestions = async () => {
        const query = input.value.trim();
        if (query.length < 3) {
          activeSuggestions = [];
          closePanel();
          return;
        }

        const requestId = ++activeRequest;
        openPanel();
        renderState("Searching components...");

        const params = new URLSearchParams({ q: query, limit: "8" });
        if (kind) params.set("kind", kind);

        try {
          const response = await fetch(`/api/catalog/search?${params.toString()}`);
          if (!response.ok) {
            throw new Error(`${response.status} ${response.statusText}`);
          }

          const payload = await response.json();
          if (requestId !== activeRequest) return;

          const suggestions = payload.suggestions ?? [];
          activeSuggestions = suggestions;

          if (!suggestions.length) {
            renderState("No matching components found.");
            return;
          }

          status.textContent = `${suggestions.length} component${suggestions.length === 1 ? "" : "s"} found`;
          renderSuggestions(suggestions);
        } catch (error) {
          if (requestId !== activeRequest) return;
          renderState("Search is unavailable right now.");
        }
      };

      input.addEventListener("input", () => {
        clearTimeout(debounceTimer);
        debounceTimer = window.setTimeout(fetchSuggestions, 180);
      });

      input.addEventListener("focus", () => {
        if (input.value.trim().length >= 3) {
          void fetchSuggestions();
        }
      });

      input.addEventListener("keydown", (event) => {
        if (event.key !== "Enter") return;
        event.preventDefault();

        if (activeSuggestions[0]) {
          navigateToSuggestion(activeSuggestions[0]);
          return;
        }

        const query = input.value.trim();
        if (!query) return;
        window.location.href = toBuildUrl({ query, launchKind });
      });

      autocompleteRoot.addEventListener("submit", (event) => {
        event.preventDefault();
        const query = input.value.trim();
        if (!query) return;
        window.location.href = toBuildUrl({ query, launchKind });
      });

      input.addEventListener("blur", () => {
        window.setTimeout(closePanel, 120);
      });
    });
  </script>
</BaseLayout>
