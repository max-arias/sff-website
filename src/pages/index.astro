---
import BaseLayout from "../layouts/BaseLayout.astro";
import { searchCatalog } from "../server/d1";

const quickSearchTerms = [
  { label: "FormD T1", kind: "case" },
  { label: "RTX 4090", kind: "gpu" },
  { label: "Velka 3", kind: "case" },
  { label: "NH-L9i", kind: "cpu-cooler" },
  { label: "SF750", kind: "psu" }
];

interface QuickSearchLink {
  label: string;
  kind: string;
  href: string;
}

const quickSearchLinks: QuickSearchLink[] = [];

for (const term of quickSearchTerms) {
  let href = "";
  try {
    const result = await searchCatalog(undefined, { query: term.label, kind: term.kind, limit: 1 });
    const suggestion = result.suggestions?.[0];
    if (suggestion) {
      const params = new URLSearchParams();
      params.set(suggestion.kind, suggestion.id);
      if (suggestion.kind === "case") {
        params.set("kind", "gpu");
      } else if (suggestion.kind === "gpu") {
        params.set("kind", "case");
      } else {
        params.set("kind", suggestion.kind);
      }
      href = `/build?${params.toString()}`;
    }
  } catch {
    // DB unavailable — link stays empty, will fall back to button
  }
  quickSearchLinks.push({ label: term.label, kind: term.kind, href });
}

const launchPaths = [
  {
    kind: "case",
    eyebrow: "Case-first flow",
    title: "Start with a Case",
    copy: "Browse cases by volume, GPU envelope, riser notes, and layout constraints before you commit to a build path.",
    cta: "Browse database",
    samples: ["FormD T1 · 9.95L", "Velka 3 · 3.96L", "A4-H2O · 11.0L"]
  },
  {
    kind: "gpu",
    eyebrow: "GPU-first flow",
    title: "Start with a GPU",
    copy: "Start from the card you own, then move into `/build` with its dimensions and fitment evidence in view.",
    cta: "Find fitment",
    samples: ["RTX 4090 · 304mm", "RX 7900 XTX · 287mm", "ProArt 4080 · 300mm"]
  }
];

---

<BaseLayout
  title="SFF Builder | Precision PC Planning"
  description="Launcher homepage for the SFF Builder fitment engine. Search parts, start from a case or GPU, and hand off into /build with replayable URL state."
>
  <div class="min-h-screen">
    <main id="top">
      <section id="launcher" class="bg-canvas-2/38 px-shell py-8 md:py-12">
        <div class="mx-auto flex max-w-[80rem] flex-col gap-4">
          <section class="launcher-panel p-6 md:p-8">
            <div class="flex items-center gap-3">
              <svg viewBox="0 0 24 24" class="h-5 w-5 text-accent" fill="none" stroke="currentColor" stroke-width="1.75">
                <circle cx="11" cy="11" r="6.5"></circle>
                <path d="M16 16L21 21"></path>
              </svg>
              <h1 class="micro-label text-ink">Quick search</h1>
            </div>

            <form class="mt-6" data-autocomplete-root>
              <label class="relative block">
                <span class="sr-only">Search components</span>
                <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-ink-faint" fill="none" stroke="currentColor" stroke-width="1.75">
                  <circle cx="11" cy="11" r="6.5"></circle>
                  <path d="M16 16L21 21"></path>
                </svg>
                <input
                  data-autocomplete-input
                  type="text"
                  placeholder="Search case, GPU, or CPU cooler..."
                  class="h-14 w-full border border-line bg-canvas-2/85 pl-12 pr-4 text-base text-ink outline-none transition placeholder:text-ink-faint focus:border-accent"
                  autocomplete="off"
                />
              </label>
              <div data-autocomplete-panel class="relative z-[70] mt-2 hidden border border-line bg-panel shadow-card">
                <div data-autocomplete-status class="px-4 py-3 text-sm text-ink-soft"></div>
                <div data-autocomplete-results class="grid"></div>
              </div>
            </form>

            <div class="mt-5 flex flex-wrap gap-2">
              {quickSearchLinks.map((link) =>
                link.href ? (
                  <a href={link.href} class="spec-chip">
                    {link.label}
                  </a>
                ) : (
                  <button
                    type="button"
                    class="spec-chip"
                    data-suggested-part
                    data-launch-query={link.label}
                    data-launch-kind={link.kind}
                  >
                    {link.label}
                  </button>
                )
              )}
            </div>

            <div class="mt-8 border-t border-line/80 pt-5 text-[1.05rem] text-ink-soft">
              Search the catalog, then launch into `/build` with a readable handoff instead of hidden session state.
            </div>
          </section>

          <div class="flex items-center gap-3 px-2">
            <svg viewBox="0 0 24 24" class="h-5 w-5 text-accent" fill="none" stroke="currentColor" stroke-width="1.75">
              <path d="M12 3v5"></path>
              <path d="M8 21l4-5 4 5"></path>
              <path d="M8.5 8.5h7v6h-7z"></path>
            </svg>
            <p class="micro-label text-ink">Build wizard</p>
          </div>

          <div class="grid gap-4 lg:grid-cols-2">
            {launchPaths.map((path) => (
              <section class="launcher-panel flex min-h-[19rem] flex-col justify-between p-6 md:p-7">
                <div>
                  <div class="mb-6 flex h-11 w-11 items-center justify-center bg-panel-3 text-accent">
                    {
                      path.kind === "case" ? (
                        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.75">
                          <path d="M6 5.5h12v13H6z"></path>
                          <path d="M9 9h6"></path>
                          <path d="M9 12.5h6"></path>
                        </svg>
                      ) : (
                        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.75">
                          <rect x="5.5" y="6.5" width="13" height="11"></rect>
                          <path d="M9 10h2M13 10h2M9 13h2M13 13h2"></path>
                        </svg>
                      )
                    }
                  </div>

                  <p class="micro-label mb-2">{path.eyebrow}</p>
                  <h2 class="text-[clamp(1.7rem,2.8vw,2.1rem)] font-semibold tracking-[-0.03em] text-ink">{path.title}</h2>
                  <p class="mt-3 max-w-[34rem] text-[1.02rem] leading-7 text-ink-soft">{path.copy}</p>

                  <form class="relative mt-6 block" data-autocomplete-root data-kind={path.kind} data-launch-kind={path.kind}>
                    <span class="sr-only">{path.title}</span>
                    <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-faint" fill="none" stroke="currentColor" stroke-width="1.75">
                      <circle cx="11" cy="11" r="6.5"></circle>
                      <path d="M16 16L21 21"></path>
                    </svg>
                    <input
                      data-autocomplete-input
                      type="text"
                      placeholder={path.kind === "case" ? "Search cases..." : "Search GPUs..."}
                      class="h-11 w-full border border-line bg-canvas-2/85 pl-10 pr-4 text-sm text-ink outline-none transition placeholder:text-ink-faint focus:border-accent"
                      autocomplete="off"
                    />
                    <div data-autocomplete-panel class="absolute left-0 right-0 top-[calc(100%+0.5rem)] z-[70] hidden border border-line bg-panel shadow-card">
                      <div data-autocomplete-status class="px-4 py-3 text-sm text-ink-soft"></div>
                      <div data-autocomplete-results class="grid"></div>
                    </div>
                  </form>

                  <div class="mt-4 flex flex-wrap gap-2">
                    {path.samples.map((sample) => (
                      <button
                        type="button"
                        class="spec-chip"
                        data-suggested-part
                        data-launch-query={sample.split(" · ")[0]}
                        data-launch-kind={path.kind}
                      >
                        {sample}
                      </button>
                    ))}
                  </div>
                </div>

                <a
                  href={path.kind === "case" ? "/build?kind=case" : "/build?kind=gpu"}
                  class="mt-8 inline-flex items-center justify-between gap-4 font-mono text-[0.72rem] font-semibold uppercase tracking-[0.12em] text-accent transition hover:text-accent-strong"
                >
                  <span>{path.cta}</span>
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.75">
                    <path d="M5 12h14"></path>
                    <path d="M13 6l6 6-6 6"></path>
                  </svg>
                </a>
              </section>
            ))}
          </div>
        </div>
      </section>

    </main>
  </div>

  <script src="../scripts/enhance-on-idle.ts"></script>
</BaseLayout>
