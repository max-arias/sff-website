---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getBuildView } from "../server/build-view";
import { buildUrl } from "../lib/build-state";

const view = await getBuildView(Astro, Astro.url);
const numericFilterNames = new Set(view.numericFilters.map((filter) => filter.name));
const numericFilterHiddenInputs = view.hiddenInputs.filter((input) => !numericFilterNames.has(input.name as never));
const hasActiveNumericFilter = view.numericFilters.some((filter) => filter.active);
const hasAnySelection = view.slots.some((s) => s.id);

const hasCase = view.slots.find((s) => s.kind === "case")?.id;
const hasGpu = view.slots.find((s) => s.kind === "gpu")?.id;
const sidebarHint = !hasCase && !hasGpu ? "Add more parts from the table"
  : hasCase && !hasGpu ? "Select a GPU to check case fitment"
  : !hasCase && hasGpu ? "Select a case to check GPU fitment"
  : "Add more parts from the table";

type PageItem =
  | { type: "page"; page: number; url: string }
  | { type: "ellipsis" };

const currentPage = view.state.page;
const totalPages = view.pageCount;
const pageItems: PageItem[] = [];
if (totalPages <= 7) {
  for (let i = 1; i <= totalPages; i++) {
    pageItems.push({ type: "page", page: i, url: buildUrl(view.state, { page: i }) });
  }
} else {
  pageItems.push({ type: "page", page: 1, url: buildUrl(view.state, { page: 1 }) });
  if (currentPage > 3) pageItems.push({ type: "ellipsis" });
  for (let i = Math.max(2, currentPage - 1); i <= Math.min(totalPages - 1, currentPage + 1); i++) {
    pageItems.push({ type: "page", page: i, url: buildUrl(view.state, { page: i }) });
  }
  if (currentPage < totalPages - 2) pageItems.push({ type: "ellipsis" });
  pageItems.push({ type: "page", page: totalPages, url: buildUrl(view.state, { page: totalPages }) });
}
---

<BaseLayout
  title="SFF Builder | Build"
  description="A replayable fitment workspace for selecting parts, inspecting constraints, and scanning pass, conditional, and fail rows."
>
  <div class="build-page">
    <!-- Mobile drawer toggle (visible below lg breakpoint) -->
    <div class="flex items-center justify-end max-w-[80rem] mx-auto px-4 lg:px-6 pt-3 lg:hidden">
      <label for="build-drawer-toggle" class="btn btn-ghost btn-sm" data-drawer-toggle>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="w-4 h-4">
          <path d="M5 5h14v14H5zM9 5v14M9 10h10M9 14h10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter"></path>
        </svg>
        <span>Build</span>
      </label>
    </div>

    <div class="drawer lg:drawer-open">
      <input id="build-drawer-toggle" type="checkbox" class="drawer-toggle" />

      <!-- ===== MAIN PANEL (drawer content) ===== -->
      <div class="drawer-content">
        <section class="main-panel">

          <!-- Kind tabs -->
          <div class="tabs tabs-bordered px-6 pt-2 sticky top-0 z-10 bg-base-200" role="tablist" aria-label="Part kinds">
            {view.kindTabs.map((tab) => (
              <a class:list={["tab font-mono text-xs font-semibold uppercase tracking-[0.06em]", { "tab-active": tab.active }]} href={tab.href} role="tab" aria-selected={tab.active ? "true" : "false"}>
                {tab.kind}
              </a>
            ))}
          </div>

          <!-- Filter bar -->
          <div class="flex items-center gap-4 px-6 py-3 border-b border-base-300 bg-base-200/50 flex-wrap sticky top-[2.75rem] z-10" data-filter-sentinel>
            <form class="relative flex-1 min-w-[12rem] max-w-[24rem]" method="GET" action={view.searchAction} data-autosubmit-form>
              <svg viewBox="0 0 24 24" aria-hidden="true" class="absolute left-3 top-1/2 -translate-y-1/2 w-[0.9rem] h-[0.9rem] text-base-content/40 pointer-events-none" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="11" cy="11" r="6.5"></circle>
                <path d="M16 16l5 5"></path>
              </svg>
              {view.hiddenInputs.map((input) => <input type="hidden" name={input.name} value={input.value} />)}
              <input name="search" value={view.state.search} type="search" placeholder="Search models..." class="input input-bordered input-sm w-full pl-8" data-autosubmit-input role="searchbox" aria-label="Search models" />
            </form>

            {view.numericFilters.length > 0 && (
              <form class="flex items-center gap-3 flex-wrap" method="GET" action={view.searchAction} data-numeric-filter-form>
                {numericFilterHiddenInputs.map((input) => <input type="hidden" name={input.name} value={input.value} />)}
                {view.state.search.trim() && <input type="hidden" name="search" value={view.state.search.trim()} />}
                {view.numericFilters.map((filter) => (
                  <label class:list={["flex items-center gap-2 px-2 py-1 border rounded-btn transition", { "border-primary": filter.active, "border-base-300": !filter.active }]} data-numeric-filter>
                    <span class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.06em] text-base-content/60 whitespace-nowrap">{filter.label}</span>
                    <input
                      class="range range-xs range-primary w-20"
                      type="range"
                      min="0"
                      max={filter.max}
                      step={filter.step}
                      value={filter.value}
                      aria-label={`${filter.label} slider`}
                      data-numeric-filter-range
                    />
                    <span class="flex items-center gap-1">
                      <input
                        type="number"
                        name={filter.name}
                        min="0"
                        max={filter.max}
                        step={filter.step}
                        value={filter.active ? filter.value : ""}
                        placeholder={`${filter.max}`}
                        class="input input-bordered input-xs w-14 text-right font-mono text-xs"
                        aria-label={filter.label}
                        data-numeric-filter-number
                      />
                      <span class="font-mono text-[0.7rem] text-base-content/40">{filter.unit}</span>
                    </span>
                  </label>
                ))}
              </form>
            )}

            {hasActiveNumericFilter && (
              <a class="btn btn-link btn-xs font-mono font-semibold" href={view.clearFiltersUrl}>Clear filters</a>
            )}
          </div>

          {view.tableNotice && <div class="mx-6 my-3 px-4 py-3 border border-base-300 rounded-btn bg-base-200 text-sm text-base-content/60">{view.tableNotice}</div>}

          <!-- Table area -->
          <div class="flex flex-1 flex-col min-h-0">
            <div class="flex-1 overflow-auto">

              <!-- Mobile cards -->
              <div class="grid gap-3 p-4 lg:hidden">
                {view.rows.map((row) => (
                  <div class:list={["card card-bordered bg-base-100", { "border-primary/30": row.verdict === "pass", "border-warning/30": row.verdict === "conditional", "border-error/30": row.verdict === "fail" }]}>
                    <div class="card-body p-0">
                      <div class="flex items-center justify-between px-4 py-3 border-b border-base-300 bg-base-200">
                        <span class:list={["badge badge-sm font-mono font-bold uppercase tracking-[0.04em]", { "badge-success": row.verdict === "pass", "badge-warning": row.verdict === "conditional", "badge-error": row.verdict === "fail", "badge-ghost": row.verdict === "unscored" }]} title={row.verdictTooltip}>{row.verdictLabel}</span>
                        <a class="btn btn-xs btn-ghost" href={row.actionUrl}>{row.actionLabel}</a>
                      </div>
                      <div class="flex flex-col gap-2 p-4">
                        <h2 class="text-base font-bold leading-tight">{row.title}</h2>
                        <p class="text-sm text-base-content/60">{row.subtitle}</p>
                        <div class="grid grid-cols-2 gap-2 py-1">
                          {row.mobileMetrics.map((m) => (
                            <div class:list={["flex flex-col p-2 border rounded-btn bg-base-200 font-mono", { "border-error/30 bg-error/5": m.alert }]}>
                              <span class:list={["text-[0.6rem] font-bold uppercase text-base-content/40", { "!text-error": m.alert }]}>{m.label}</span>
                              <span class:list={["text-sm font-bold", { "text-error": m.alert }]}>{m.value}</span>
                            </div>
                          ))}
                        </div>
                        {row.note && <p class="px-3 py-2 text-sm text-base-content/60 bg-base-200 rounded-btn">{row.note}</p>}
                      </div>
                    </div>
                  </div>
                ))}
              </div>

              <!-- Desktop table -->
              <table class="table table-zebra table-sm hidden lg:table">
                <thead>
                  <tr>
                    {view.tableHeaders.map((header) => (
                      <th class="sticky top-0 z-10 bg-base-200 font-mono text-[0.7rem] font-bold uppercase tracking-[0.06em] text-base-content/60 whitespace-nowrap" aria-sort={header.sortable ? (header.sortDir === "asc" ? "ascending" : header.sortDir === "desc" ? "descending" : "none") : undefined}>
                        {header.sortable ? (
                          <span class="inline-flex items-center gap-1.5">
                            <a class:list={["inline-flex items-center gap-1 no-underline transition hover:text-primary", { "text-primary": header.sortDir }]} href={header.sortUrl}>
                              <span>{header.label}</span>
                              <span class="flex flex-col items-center leading-[0.6] text-base-content/40" aria-hidden="true">
                                <svg width="10" height="14" viewBox="0 0 10 14">
                                  <path d="M5 3L2 7h6L5 3z" fill="currentColor" opacity={header.sortDir === "asc" ? "1" : "0.25"} />
                                  <path d="M5 11l3-4H2l3 4z" fill="currentColor" opacity={header.sortDir === "desc" ? "1" : "0.25"} />
                                </svg>
                              </span>
                            </a>
                            {view.state.kind === "psu" && header.label === "Tier" && (
                              <span class="relative z-[3] inline-grid w-4 h-4 place-items-center border border-base-content/20 rounded-full text-base-content/60 cursor-help text-[0.68rem] font-extrabold leading-none info-trigger" tabindex="0" aria-label="About PSU tier ratings">
                                i
                                <span class="absolute z-[200] top-[calc(100%+0.45rem)] left-1/2 -translate-x-1/2 hidden w-[min(17rem,72vw)] border border-base-300 rounded-box bg-base-100 shadow-lg text-base-content p-2.5 text-xs font-medium leading-relaxed whitespace-normal info-popover" role="tooltip">
                                  Community PSU quality rating from SPL's PSU Tier List. Unmatched PSUs show "-".
                                  <a href={view.psuTierSourceUrl} target="_blank" rel="noreferrer">Open source</a>
                                </span>
                              </span>
                            )}
                          </span>
                        ) : (
                          header.label
                        )}
                      </th>
                    ))}
                  </tr>
                </thead>

                {view.rows.length > 0 && (
                  <tbody>
                    {view.rows.map((row) => (
                      <tr class:list={["transition-colors", { "bg-primary/5 shadow-[inset_4px_0_0_0_var(--color-primary)]": row.selected }]}>
                        <td class="whitespace-nowrap w-[1%]">
                          <span class:list={["badge badge-sm font-mono font-bold uppercase tracking-[0.04em]", { "badge-success": row.verdict === "pass", "badge-warning": row.verdict === "conditional", "badge-error": row.verdict === "fail", "badge-ghost": row.verdict === "unscored" }]} title={row.verdictTooltip}>{row.verdictLabel}</span>
                        </td>
                        <td>
                          <div class="grid gap-0.5">
                            <strong class="text-[0.95rem] font-semibold">{row.title}</strong>
                            <span class="text-sm text-base-content/60">{row.subtitle}</span>
                          </div>
                        </td>
                        {row.cells.map((value, index) => (
                          <td class:list={["font-mono text-sm whitespace-nowrap", { "bg-error/10 !text-error font-bold": row.highlightCellIndex === index }]}>
                            {value}
                          </td>
                        ))}
                        <td class="w-[min(18rem,25vw)] max-w-[22rem] text-sm text-base-content/60 leading-relaxed">{row.note}</td>
                        <td class="whitespace-nowrap w-[1%]">
                          <a class="btn btn-xs btn-ghost" href={row.actionUrl}>{row.actionLabel}</a>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                )}
              </table>

              {view.rows.length === 0 && <div class="py-8 px-6 text-center text-base-content/40 text-sm">No rows match the active filters.</div>}
            </div>

            <!-- Table footer / pagination -->
            <footer class="flex items-center justify-between gap-4 px-6 py-3 border-t border-base-300 bg-base-100">
              <span class="text-sm text-base-content/40">{view.displayStart}-{view.displayEnd} of {view.totalRows} rows</span>
              <div class="join">
                <a
                  class:list={["join-item btn btn-sm", { "btn-disabled": view.state.page <= 1 }]}
                  href={view.previousUrl}
                  aria-label="Previous page"
                  aria-disabled={view.state.page <= 1 ? "true" : undefined}
                  tabindex={view.state.page <= 1 ? -1 : undefined}
                >
                  <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M9 2L4 7l5 5" fill="none" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </a>
                {pageItems.map((item) => (
                  item.type === "ellipsis" ? (
                    <span class="join-item btn btn-sm btn-disabled">...</span>
                  ) : (
                    <a
                      class:list={["join-item btn btn-sm", { "btn-active": item.page === currentPage }]}
                      href={item.url}
                      aria-label={`Page ${item.page}`}
                      aria-current={item.page === currentPage ? "page" : undefined}
                    >
                      {item.page}
                    </a>
                  )
                ))}
                <a
                  class:list={["join-item btn btn-sm", { "btn-disabled": view.state.page >= view.pageCount }]}
                  href={view.nextUrl}
                  aria-label="Next page"
                  aria-disabled={view.state.page >= view.pageCount ? "true" : undefined}
                  tabindex={view.state.page >= view.pageCount ? -1 : undefined}
                >
                  <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M5 2l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </a>
              </div>
            </footer>
          </div>
        </section>
      </div>

      <!-- ===== SIDEBAR (drawer side) ===== -->
      <div class="drawer-side z-50">
        <label for="build-drawer-toggle" aria-label="close sidebar" class="drawer-overlay"></label>
        <aside id="build-drawer" class="sidebar flex flex-col w-80 h-full bg-base-200 border-r border-base-300 overflow-y-auto" data-drawer>

          <!-- Sidebar header -->
          <div class="flex items-start justify-between gap-4 p-5 border-b border-base-300">
            <div>
              <h1 class="text-xl font-bold tracking-[-0.02em] mb-1">{hasAnySelection ? "Current Build" : "SFF Builder"}</h1>
              {hasAnySelection && (
                <p class="text-sm text-base-content/60">
                  Status:
                  <strong class:list={[{ "text-warning": view.buildStatus === "in-progress" || view.buildStatus === "conditional", "text-success": view.buildStatus === "pass", "text-error": view.buildStatus === "fail" }]}>
                    {view.buildStatusLabel}
                  </strong>
                </p>
              )}
              {hasAnySelection && view.buildStatusCopy && <span class="block mt-2 text-sm text-base-content/60 leading-relaxed">{view.buildStatusCopy}</span>}
              {!hasAnySelection && (
                <p class="text-sm text-base-content/60">Fitment engine for small-form-factor PC builds.</p>
              )}
            </div>
            <label for="build-drawer-toggle" class="btn btn-sm btn-ghost btn-square lg:hidden" aria-label="Close current build panel">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="w-[0.9rem] h-[0.9rem]">
                <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"></path>
              </svg>
            </label>
          </div>

          <!-- Slot cards / onboarding -->
          <div class="grid gap-2.5 p-4">
            {!hasAnySelection ? (
              <div class="card card-bordered bg-base-100">
                <div class="card-body p-5 gap-0">
                  <h2 class="text-lg font-bold tracking-[-0.01em] mb-3">Getting Started</h2>
                  <p class="text-sm text-base-content/60 leading-relaxed mb-3">
                    This tool checks whether PC parts physically fit together.
                    Search for a case or GPU in the table, then add more parts to check compatibility.
                  </p>
                  <p class="text-sm text-base-content/60 leading-relaxed">
                    Dimensions are compared in millimeters. Results show
                    {" "}<span class="badge badge-xs badge-success font-mono font-bold !text-success-content">PASS</span>{" "}
                    (fits),
                    {" "}<span class="badge badge-xs badge-warning font-mono font-bold !text-warning-content">CONDITIONAL</span>{" "}
                    (may fit — check notes), or
                    {" "}<span class="badge badge-xs badge-error font-mono font-bold !text-error-content">FAIL</span>{" "}
                    (won't fit). You can still select failing parts to understand why.
                  </p>
                </div>
              </div>
            ) : (
              <>
                {view.slots.filter((s) => s.id).map((slot) => (
                  <div
                    class:list={[
                      "card card-bordered bg-base-100 transition-colors",
                      `border-l-[3px]`,
                      {
                        "border-l-primary": slot.verdict === "pass",
                        "border-l-warning": slot.verdict === "conditional",
                        "border-l-error": slot.verdict === "fail" || slot.state === "unresolved",
                        "!border-l-white bg-primary/10": slot.kind === view.state.kind
                      }
                    ]}
                  >
                    <div class="card-body p-3.5 gap-0">
                      <div class="flex items-center justify-between gap-2">
                        <span class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.1em] text-base-content/60">{slot.label}</span>
                        <div class="flex items-center gap-1.5">
                          <span class:list={["badge badge-xs font-mono font-bold uppercase tracking-[0.06em]", { "badge-success": slot.verdict === "pass", "badge-warning": slot.verdict === "conditional", "badge-error": slot.verdict === "fail", "badge-ghost": slot.verdict === "unscored" }]} title={slot.verdictTooltip}>{slot.verdictCopy}</span>
                          <a class="btn btn-xs btn-ghost btn-square text-error" href={slot.clearUrl} aria-label={`Clear ${slot.kind}`} title="Clear">
                            <svg viewBox="0 0 24 24" aria-hidden="true" class="w-3 h-3">
                              <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"></path>
                            </svg>
                          </a>
                        </div>
                      </div>

                      <h2 class="text-base font-semibold leading-tight mt-2.5 mb-0.5">{slot.title}</h2>
                      {slot.subtitle && <p class="text-sm text-base-content/60">{slot.subtitle}</p>}
                      {slot.note && <p class="mt-2 p-2 bg-error/10 rounded-btn text-sm text-base-content/60">{slot.note}</p>}
                      {slot.specs.length > 0 && (
                        <dl class="grid grid-cols-2 gap-x-3 gap-y-1.5 mt-2.5 pt-2.5 border-t border-base-300">
                          {slot.specs.map((spec) => (
                            <div>
                              <dt class="font-mono text-[0.6rem] font-bold uppercase tracking-[0.08em] text-base-content/60">{spec.label}</dt>
                              <dd class="text-sm font-medium mt-0.5 leading-tight break-words">{spec.value}</dd>
                            </div>
                          ))}
                        </dl>
                      )}
                    </div>
                  </div>
                ))}
                {view.slots.some((s) => !s.id) && (
                  <p class="text-xs text-base-content/40 pt-1 pb-1 text-center">{sidebarHint}</p>
                )}
              </>
            )}
          </div>

          <!-- Build issues -->
          {view.buildIssues.length > 0 && (
            <div class="mt-auto mx-4 mb-5 p-4 border-t border-error/30 bg-error/5">
              <h3 class="font-mono text-[0.7rem] font-bold uppercase tracking-[0.1em] text-error mb-3">Build Issues</h3>
              {view.buildIssues.map((section) => (
                <div class="[&+&]:mt-3">
                  <strong class="text-sm">{section.label}</strong>
                  <ul class="mt-1.5 ml-4 text-sm text-base-content/60 leading-relaxed list-disc">
                    {section.issues.map((issue) => <li>{issue}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          )}
        </aside>
      </div>
    </div>
  </div>

  <script src="../scripts/enhance-on-idle.ts"></script>
</BaseLayout>
