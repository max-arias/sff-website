---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getBuildView } from "../server/build-view";
import { buildUrl } from "../lib/build-state";

const view = await getBuildView(Astro, Astro.url);
const numericFilterNames = new Set(view.numericFilters.map((filter) => filter.name));
const numericFilterHiddenInputs = view.hiddenInputs.filter((input) => !numericFilterNames.has(input.name as never));
const sparseToggleHiddenInputs = view.hiddenInputs.filter((input) => input.name !== "show-sparse");
const sparseRowsTooltip = "Rows without fitment-relevant data are hidden by default. Turn this on to include them.";
const hasActiveNumericFilter = view.numericFilterGroups.some((group) => group.activeCount > 0) || Boolean(view.state.caseVolumeTier) || Boolean(view.state.caseIntent);
const hasAnySelection = view.slots.some((s) => s.id);
const actionHeader = view.tableHeaders.find((header) => header.label === "Action");
const dataTableHeaders = view.tableHeaders.filter((header) => header.label !== "Action");

const hasCase = view.slots.find((s) => s.kind === "case")?.id;
const hasGpu = view.slots.find((s) => s.kind === "gpu")?.id;
const sidebarHint = !hasCase && !hasGpu ? "Add more parts from the table"
  : hasCase && !hasGpu ? "Select a GPU to check case fitment"
  : !hasCase && hasGpu ? "Select a case to check GPU fitment"
  : "Add more parts from the table";

type PageItem =
  | { type: "page"; page: number; url: string }
  | { type: "ellipsis" };

const currentPage = view.state.page;
const totalPages = view.pageCount;
const pageItems: PageItem[] = [];
if (totalPages <= 7) {
  for (let i = 1; i <= totalPages; i++) {
    pageItems.push({ type: "page", page: i, url: buildUrl(view.state, { page: i }) });
  }
} else {
  pageItems.push({ type: "page", page: 1, url: buildUrl(view.state, { page: 1 }) });
  if (currentPage > 3) pageItems.push({ type: "ellipsis" });
  for (let i = Math.max(2, currentPage - 1); i <= Math.min(totalPages - 1, currentPage + 1); i++) {
    pageItems.push({ type: "page", page: i, url: buildUrl(view.state, { page: i }) });
  }
  if (currentPage < totalPages - 2) pageItems.push({ type: "ellipsis" });
  pageItems.push({ type: "page", page: totalPages, url: buildUrl(view.state, { page: totalPages }) });
}

function isPsuBadge(value: string): boolean {
  return value.includes("data-psu-tier-badge");
}

function psuBadgeBackground(value: string): string | undefined {
  const match = value.match(/data-psu-tier-bg="([^"]+)"/);
  return match?.[1];
}
---

<BaseLayout
  title="SFF Builder | Build"
  description="A replayable fitment workspace for selecting parts, inspecting constraints, and scanning pass, conditional, and fail rows."
>
  <div class="build-page">
    <!-- Mobile drawer toggle (visible below lg breakpoint) -->
    <div class="flex items-center justify-end max-w-[80rem] mx-auto px-4 lg:px-6 pt-3 lg:hidden">
      <label for="build-drawer-toggle" class="btn btn-ghost btn-sm" data-drawer-toggle>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="w-4 h-4">
          <path d="M5 5h14v14H5zM9 5v14M9 10h10M9 14h10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter"></path>
        </svg>
        <span>Build</span>
      </label>
    </div>

    <div class="drawer lg:drawer-open">
      <input id="build-drawer-toggle" type="checkbox" class="drawer-toggle" />

      <!-- ===== MAIN PANEL (drawer content) ===== -->
      <div class="drawer-content">
        <section class="main-panel flex flex-col min-h-0">

          <!-- Kind tabs -->
          <div class="overflow-x-auto px-6 pt-2">
            <div class="tabs tabs-lift min-w-max" role="tablist" aria-label="Part kinds">
              {view.kindTabs.map((tab) => (
                <a
                  class:list={[
                    "tab font-mono text-xs font-semibold uppercase tracking-[0.06em]",
                    { "tab-active": tab.active },
                  ]}
                  href={tab.href}
                  role="tab"
                  aria-selected={tab.active ? "true" : "false"}
                >
                  {tab.kind}
                </a>
              ))}
            </div>
          </div>

          <!-- Compact filter toolbar -->
          <div class="flex items-center gap-3 px-6 py-2.5 border-b border-base-300 bg-base-200/60 flex-wrap">
            <!-- Search -->
            <form class="relative flex-shrink-0 w-[14rem]" method="GET" action={view.searchAction} data-autosubmit-form>
              <svg viewBox="0 0 24 24" aria-hidden="true" class="absolute left-2.5 top-1/2 -translate-y-1/2 w-[0.85rem] h-[0.85rem] text-base-content/40 pointer-events-none" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="11" cy="11" r="6.5"></circle>
                <path d="M16 16l5 5"></path>
              </svg>
              {view.hiddenInputs.map((input) => <input type="hidden" name={input.name} value={input.value} />)}
              <input name="search" value={view.state.search} type="search" placeholder="Search models..." class="input input-bordered input-xs w-full pl-7 font-mono text-xs" data-autosubmit-input role="searchbox" aria-label="Search models" />
            </form>

            <!-- Numeric filter group chips -->
            {view.numericFilterGroups.length > 0 && (
              <form class="flex items-center gap-1.5 flex-wrap" method="GET" action={view.searchAction} data-numeric-filter-form>
                {numericFilterHiddenInputs.map((input) => <input type="hidden" name={input.name} value={input.value} />)}
                {view.state.search.trim() && <input type="hidden" name="search" value={view.state.search.trim()} />}
                {view.numericFilterGroups.map((group) => (
                  <div class="relative" data-filter-chip-wrapper>
                    <button
                      type="button"
                      class:list={["filter-chip", { "filter-chip-active": group.activeCount > 0 }]}
                      data-filter-chip
                      aria-expanded="false"
                      aria-controls={`filter-popover-${group.label.replace(/\s+/g, "-").toLowerCase()}`}
                    >
                      <span class="filter-chip-label">{group.label}</span>
                      <span class="filter-chip-value">{group.summary}</span>
                    </button>
                    <div
                      id={`filter-popover-${group.label.replace(/\s+/g, "-").toLowerCase()}`}
                      class="filter-popover"
                      data-filter-popover
                    >
                      <div class="filter-popover-header">{group.label}</div>
                      <div class="filter-popover-body">
                        {group.options.length > 0 && (
                          <div class="flex flex-col gap-1.5">
                            <span class="font-mono text-[0.6rem] font-bold uppercase tracking-[0.06em] text-base-content/60">Options</span>
                            <div class="flex flex-wrap gap-1.5">
                              {group.options.map((option) => (
                                <a
                                  href={option.href}
                                  class:list={["btn btn-xs font-mono inline-flex items-center gap-1", { "btn-primary": option.active, "btn-outline": !option.active }]}
                                >
                                  <span>{option.label}</span>
                                  {option.tooltip && (
                                    <span class="inline-grid w-3 h-3 place-items-center border border-current rounded-full text-[0.5rem] font-extrabold leading-none cursor-help" title={option.tooltip} aria-label={option.tooltip} tabindex="0">i</span>
                                  )}
                                </a>
                              ))}
                            </div>
                          </div>
                        )}
                        {group.filters.map((filter) => (
                          <label class="flex flex-col gap-1" data-numeric-filter>
                            <span class="font-mono text-[0.6rem] font-bold uppercase tracking-[0.06em] text-base-content/60">{filter.label}</span>
                            <input
                              class="range range-xs range-primary"
                              type="range"
                              min="0"
                              max={filter.max}
                              step={filter.step}
                              value={filter.value}
                              aria-label={`${filter.label} slider`}
                              data-numeric-filter-range
                            />
                            <div class="flex items-center gap-1">
                              <input
                                type="number"
                                name={filter.active ? filter.name : undefined}
                                data-filter-name={filter.name}
                                min="0"
                                max={filter.max}
                                step={filter.step}
                                value={filter.active || filter.derived ? filter.value : ""}
                                placeholder={`${filter.max}`}
                                class="input input-bordered input-xs w-20 text-right font-mono text-xs"
                                aria-label={filter.label}
                                data-numeric-filter-number
                              />
                              <span class="font-mono text-[0.7rem] text-base-content/40">{filter.unit}</span>
                            </div>
                          </label>
                        ))}
                      </div>
                    </div>
                  </div>
                ))}
              </form>
            )}

            <!-- Sparse rows toggle -->
            <form method="GET" action={view.searchAction} class="flex items-center flex-shrink-0" data-sparse-toggle-form>
              {sparseToggleHiddenInputs.map((input) => <input type="hidden" name={input.name} value={input.value} />)}
              {view.state.search.trim() && <input type="hidden" name="search" value={view.state.search.trim()} />}
              <label class:list={["flex items-center gap-1.5 px-2 py-1 border rounded-md cursor-pointer transition", { "border-primary bg-primary/5": view.state.showSparseRows, "border-base-300": !view.state.showSparseRows }] }>
                <input
                  type="checkbox"
                  name="show-sparse"
                  value="1"
                  checked={view.state.showSparseRows}
                  class="toggle toggle-primary toggle-xs"
                  aria-label="Show sparse rows"
                  onchange="this.form?.requestSubmit()"
                />
                <span class="font-mono text-[0.6rem] font-bold uppercase tracking-[0.06em] text-base-content/60 whitespace-nowrap">Sparse</span>
                <span class="tooltip tooltip-top z-20" data-tip={sparseRowsTooltip}>
                  <span class="inline-grid w-3.5 h-3.5 place-items-center border border-base-content/20 rounded-full text-base-content/50 text-[0.58rem] font-extrabold leading-none cursor-help" aria-label={sparseRowsTooltip} tabindex="0">i</span>
                </span>
              </label>
            </form>

            {hasActiveNumericFilter && (
              <a class="btn btn-link btn-xs font-mono font-semibold flex-shrink-0" href={view.clearFiltersUrl}>Clear</a>
            )}
          </div>

          {view.tableNotice && <div class="mx-6 my-3 px-4 py-3 border border-base-300 rounded-btn bg-base-200 text-sm text-base-content/60">{view.tableNotice}</div>}

          <!-- Table area -->
          <div class="flex flex-1 flex-col min-h-0 overflow-hidden">
            <div class="flex-1 overflow-auto">

              <!-- Mobile cards -->
              <div class="grid gap-3 p-4 lg:hidden">
                {view.rows.map((row) => (
                  <div class:list={["card card-bordered bg-base-100", { "bg-success/[0.05] border-success/25": row.verdict === "pass", "bg-warning/[0.06] border-warning/30": row.verdict === "conditional", "bg-error/[0.06] border-error/30": row.verdict === "fail" }]}>
                    <div class="flex items-center justify-end px-4 py-3 border-b border-base-300/70 bg-base-200/60">
                      <a class:list={["btn btn-xs", { "btn-primary": row.selected, "btn-ghost": !row.selected }]} href={row.actionUrl}>{row.actionLabel}</a>
                    </div>
                    <div class="flex flex-col gap-2 p-4">
                      <h2 class="truncate text-base font-semibold leading-tight" title={row.title}>{row.title}</h2>
                      <div class="grid grid-cols-2 gap-2 py-1">
                        {row.mobileMetrics.map((m) => (
                          <div class:list={["flex flex-col p-2.5 border rounded-btn bg-base-200 font-mono", { "border-error/25 bg-error/[0.04]": m.alert }]}>
                            <span class:list={["text-[0.6rem] font-bold uppercase tracking-wider text-base-content/40", { "!text-error": m.alert }]}>{m.label}</span>
                            {isPsuBadge(m.value) ? (
                              <span class:list={["text-sm font-semibold rounded-md px-1.5 py-0.5", { "text-error font-bold": m.alert }]} style={{ backgroundColor: psuBadgeBackground(m.value) }} set:html={m.value} />
                            ) : (
                              <span class:list={["text-sm font-semibold", { "text-error font-bold": m.alert }]}>{m.value}</span>
                            )}
                          </div>
                        ))}
                      </div>
                      {row.note && (
                        isPsuBadge(row.note) ? (
                          <p class="px-3 py-2 text-sm text-base-content/70 bg-base-200 rounded-btn leading-relaxed" set:html={row.note} />
                        ) : (
                          <p class="px-3 py-2 text-sm text-base-content/70 bg-base-200 rounded-btn leading-relaxed">{row.note}</p>
                        )
                      )}
                    </div>
                  </div>
                ))}
              </div>

              <!-- Desktop table -->
              <table class="data-table hidden lg:table">
                <thead>
                  <tr>
                    {actionHeader && <th class="action-column">{actionHeader.label}</th>}
                    {dataTableHeaders.map((header) => (
                      <th class:list={{ "notes-column": header.key === "notes" }} aria-sort={header.sortable ? (header.sortDir === "asc" ? "ascending" : header.sortDir === "desc" ? "descending" : "none") : undefined}>
                        {header.sortable ? (
                          <span class="inline-flex items-center gap-1.5">
                            <a class:list={["inline-flex items-center gap-1 no-underline transition hover:text-primary", { "text-primary": header.sortDir }]} href={header.sortUrl}>
                              <span>{header.label}</span>
                              <span class="flex flex-col items-center leading-[0.6] text-base-content/40" aria-hidden="true">
                                <svg width="10" height="14" viewBox="0 0 10 14">
                                  <path d="M5 3L2 7h6L5 3z" fill="currentColor" opacity={header.sortDir === "asc" ? "1" : "0.25"} />
                                  <path d="M5 11l3-4H2l3 4z" fill="currentColor" opacity={header.sortDir === "desc" ? "1" : "0.25"} />
                                </svg>
                              </span>
                            </a>
                            {view.state.kind === "psu" && header.label === "Tier" && (
                              <span class="relative z-[3] inline-grid w-4 h-4 place-items-center border border-base-content/20 rounded-full text-base-content/60 cursor-help text-[0.68rem] font-extrabold leading-none info-trigger" tabindex="0" aria-label="About PSU tier ratings">
                                i
                                <span class="absolute z-[200] top-[calc(100%+0.45rem)] left-1/2 -translate-x-1/2 hidden w-[min(17rem,72vw)] border border-base-300 rounded-box bg-base-100 shadow-lg text-base-content p-2.5 text-xs font-medium leading-relaxed whitespace-normal info-popover" role="tooltip">
                                  Community PSU quality rating from SPL's PSU Tier List. Unmatched PSUs show "-".
                                  <a href={view.psuTierSourceUrl} target="_blank" rel="noreferrer">Open source</a>
                                </span>
                              </span>
                            )}
                          </span>
                        ) : (
                          header.label
                        )}
                      </th>
                    ))}
                  </tr>
                </thead>

                {view.rows.length > 0 && (
                  <tbody>
                    {view.rows.map((row) => (
                      <tr class:list={[
                        "data-row",
                        `data-row-${row.verdict}`,
                        { "data-row-selected": row.selected },
                      ]}>
                        <td class="action-column whitespace-nowrap w-[1%]">
                          <a class:list={["btn btn-xs", { "btn-primary": row.selected, "btn-ghost": !row.selected }]} href={row.actionUrl}>{row.actionLabel}</a>
                        </td>
                        <td>
                          <strong class="block max-w-[24rem] truncate text-[0.95rem] font-semibold leading-snug" title={row.title}>{row.title}</strong>
                        </td>
                        {row.cells.map((cell) => {
                          const cellStyle = cell.evidenceVerdict === "fail"
                            ? "bg-error/[0.06] !text-error font-bold"
                            : cell.evidenceVerdict === "conditional"
                              ? "bg-warning/[0.04] !text-warning font-semibold"
                              : "";
                          return (
                            <td class:list={["font-mono text-sm whitespace-nowrap tabular-nums", cellStyle]} style={isPsuBadge(cell.value) ? { backgroundColor: psuBadgeBackground(cell.value) } : undefined} title={cell.evidenceMessages.join("; ")}>
                              {isPsuBadge(cell.value) ? <Fragment set:html={cell.value} /> : cell.value}
                            </td>
                          );
                        })}
                        <td class="notes-column text-sm text-base-content/60 leading-relaxed">{isPsuBadge(row.note) ? <Fragment set:html={row.note} /> : row.note}</td>
                      </tr>
                    ))}
                  </tbody>
                )}
              </table>

              {view.rows.length === 0 && (
                <div class="py-10 px-6 text-center">
                  <p class="text-sm font-medium text-base-content/50">No rows match the active filters.</p>
                  {hasActiveNumericFilter && <a class="btn btn-link btn-sm mt-3" href={view.clearFiltersUrl}>Clear filters</a>}
                </div>
              )}
            </div>

            <!-- Table footer / pagination -->
            <footer class="flex flex-shrink-0 items-center justify-between gap-4 px-6 py-3 border-t border-base-300 bg-base-100">
              <span class="text-sm text-base-content/40">{view.displayStart}-{view.displayEnd} of {view.totalRows} rows</span>
              <div class="join">
                <a
                  class:list={["join-item btn btn-sm", { "btn-disabled": view.state.page <= 1 }]}
                  href={view.previousUrl}
                  aria-label="Previous page"
                  aria-disabled={view.state.page <= 1 ? "true" : undefined}
                  tabindex={view.state.page <= 1 ? -1 : undefined}
                >
                  <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M9 2L4 7l5 5" fill="none" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </a>
                {pageItems.map((item) => (
                  item.type === "ellipsis" ? (
                    <span class="join-item btn btn-sm btn-disabled">...</span>
                  ) : (
                    <a
                      class:list={["join-item btn btn-sm", { "btn-active": item.page === currentPage }]}
                      href={item.url}
                      aria-label={`Page ${item.page}`}
                      aria-current={item.page === currentPage ? "page" : undefined}
                    >
                      {item.page}
                    </a>
                  )
                ))}
                <a
                  class:list={["join-item btn btn-sm", { "btn-disabled": view.state.page >= view.pageCount }]}
                  href={view.nextUrl}
                  aria-label="Next page"
                  aria-disabled={view.state.page >= view.pageCount ? "true" : undefined}
                  tabindex={view.state.page >= view.pageCount ? -1 : undefined}
                >
                  <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M5 2l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </a>
              </div>
            </footer>
          </div>
        </section>
      </div>

      <!-- ===== SIDEBAR (drawer side) ===== -->
      <div class="drawer-side z-50">
        <label for="build-drawer-toggle" aria-label="close sidebar" class="drawer-overlay"></label>
        <aside id="build-drawer" class="sidebar flex flex-col w-80 h-full bg-base-200 border-r border-base-300 overflow-y-auto" data-drawer>

          <!-- Sidebar header -->
          <div class="flex items-start justify-between gap-4 p-5 border-b border-base-300">
            <div>
              <h1 class="text-xl font-bold tracking-[-0.02em] mb-1">{hasAnySelection ? "Current Build" : "SFF Builder"}</h1>
              {hasAnySelection && (
                <p class="text-sm text-base-content/60">
                  Status:{" "}
                  <strong class:list={[{ "text-warning": view.buildStatus === "in-progress" || view.buildStatus === "conditional", "text-success": view.buildStatus === "pass", "text-error": view.buildStatus === "fail" }]}>
                    {view.buildStatusLabel}
                  </strong>
                </p>
              )}
              {hasAnySelection && view.buildStatusCopy && <span class="block mt-2 text-sm text-base-content/60 leading-relaxed">{view.buildStatusCopy}</span>}
              {!hasAnySelection && (
                <p class="text-sm text-base-content/60">Fitment engine for small-form-factor PC builds.</p>
              )}
            </div>
            <label for="build-drawer-toggle" class="btn btn-sm btn-ghost btn-square lg:hidden" aria-label="Close current build panel">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="w-[0.9rem] h-[0.9rem]">
                <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"></path>
              </svg>
            </label>
          </div>

          <!-- Slot cards / onboarding -->
          <div class="grid gap-2.5 p-4">
            {!hasAnySelection ? (
              <div class="card card-bordered bg-base-100">
                <div class="card-body p-5 gap-0">
                  <h2 class="text-lg font-bold tracking-[-0.01em] mb-3">Getting Started</h2>
                  <p class="text-sm text-base-content/60 leading-relaxed mb-3">
                    This tool checks whether PC parts physically fit together.
                    Search for a case or GPU in the table, then add more parts to check compatibility.
                  </p>
                  <p class="text-sm text-base-content/60 leading-relaxed">
                    Dimensions are compared in millimeters. Results show
                    {" "}<span class="badge badge-xs badge-success font-mono font-bold !text-success-content">PASS</span>{" "}
                    (fits),
                    {" "}<span class="badge badge-xs badge-warning font-mono font-bold !text-warning-content">CONDITIONAL</span>{" "}
                    (may fit — check notes), or
                    {" "}<span class="badge badge-xs badge-error font-mono font-bold !text-error-content">FAIL</span>{" "}
                    (won't fit). You can still select failing parts to understand why.
                  </p>
                </div>
              </div>
            ) : (
              <>
                {view.slots.filter((s) => s.id).map((slot) => (
                  <div
                    class:list={[
                      "card card-bordered bg-base-100 transition-colors",
                      {
                        "border-t-2 border-t-primary": slot.verdict === "pass" && slot.kind !== view.state.kind,
                        "border-t-2 border-t-warning": slot.verdict === "conditional" && slot.kind !== view.state.kind,
                        "border-t-2 border-t-error": (slot.verdict === "fail" || slot.state === "unresolved") && slot.kind !== view.state.kind,
                        "ring-1 ring-primary/20 bg-primary/[0.05]": slot.kind === view.state.kind
                      }
                    ]}
                  >
                    <div class="card-body p-3.5 gap-0">
                      <div class="flex items-center justify-between gap-2">
                        <span class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.1em] text-base-content/60">{slot.label}</span>
                        <div class="flex items-center gap-1.5">
                          <span class:list={["badge badge-xs font-mono font-bold uppercase tracking-[0.06em]", { "badge-success": slot.verdict === "pass", "badge-warning": slot.verdict === "conditional", "badge-error": slot.verdict === "fail", "badge-ghost": slot.verdict === "unscored" }]} title={slot.verdictTooltip}>{slot.verdictCopy}</span>
                          <a class="btn btn-xs btn-ghost btn-square text-error" href={slot.clearUrl} aria-label={`Clear ${slot.kind}`} title="Clear">
                            <svg viewBox="0 0 24 24" aria-hidden="true" class="w-3 h-3">
                              <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"></path>
                            </svg>
                          </a>
                        </div>
                      </div>

                      <h2 class="text-base font-semibold leading-tight mt-2.5 mb-0.5">{slot.title}</h2>
                      {slot.subtitle && (
                        isPsuBadge(slot.subtitle) ? (
                          <p class="text-sm text-base-content/60" set:html={slot.subtitle} />
                        ) : (
                          <p class="text-sm text-base-content/60">{slot.subtitle}</p>
                        )
                      )}
                      {slot.note && <p class="mt-2 p-2 bg-error/10 rounded-btn text-sm text-base-content/60">{slot.note}</p>}
                      {slot.specs.length > 0 && (
                        <dl class="grid grid-cols-2 gap-x-3 gap-y-1.5 mt-2.5 pt-2.5 border-t border-base-300">
                          {slot.specs.map((spec) => (
                            <div>
                              <dt class="font-mono text-[0.6rem] font-bold uppercase tracking-[0.08em] text-base-content/60">{spec.label}</dt>
                              {isPsuBadge(spec.value) ? (
                                <dd class="text-sm font-medium mt-0.5 leading-tight break-words" set:html={spec.value} />
                              ) : (
                                <dd class="text-sm font-medium mt-0.5 leading-tight break-words">{spec.value}</dd>
                              )}
                            </div>
                          ))}
                        </dl>
                      )}
                    </div>
                  </div>
                ))}
                {view.slots.some((s) => !s.id) && (
                  <p class="text-xs text-base-content/50 pt-2 pb-1 text-center font-medium">{sidebarHint}</p>
                )}
              </>
            )}
          </div>

          <!-- Build issues -->
          {view.buildIssues.length > 0 && (
            <div class="mt-auto mx-4 mb-5 p-4 border border-error/20 rounded-btn bg-error/[0.04]">
              <h3 class="font-mono text-[0.7rem] font-bold uppercase tracking-[0.1em] text-error mb-3">Build Issues</h3>
              {view.buildIssues.map((section) => (
                <div class="[&+&]:mt-3">
                  <strong class="text-sm">{section.label}</strong>
                  <ul class="mt-1.5 ml-4 text-sm text-base-content/60 leading-relaxed list-disc">
                    {section.issues.map((issue) => <li>{issue}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          )}
        </aside>
      </div>
    </div>
  </div>

  <script src="../scripts/enhance-on-idle.ts"></script>
</BaseLayout>
